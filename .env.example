# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FFmpeg Processing Server (External VPS)
FFMPEG_SERVER_URL=http://your-vps-ip:3001
FFMPEG_SERVER_SECRET=your-secret-key

# Cloud Storage (choose one)
# Vercel Blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=clipboost-videos

# Database (optional, for user management)
DATABASE_URL=postgresql://user:password@localhost:5432/clipboost

# Auth (optional)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=true
